; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Neighborhood Demo"
run/main_scene="res://example/scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

World="*res://addons/world_manager/runtime/world.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/liberty_character_editor/plugin.cfg", "res://addons/world_manager/plugin.cfg", "res://addons/rule_engine/plugin.cfg")

